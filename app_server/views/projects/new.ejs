<div class="page-head">
    <h1>Yeni layihe</h1>
    <a href="/projects" class="btn-light">← Geri</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <span class="alert-icon">!</span>
        <%= error %>
    </div>
<% } %>

<div class="form-card">
    <form method="POST" action="/projects/new" class="form">
        <div class="form-group">
            <label for="title">Basliq</label>
            <input type="text" id="title" name="title" value="<%= (typeof form !== 'undefined' && form.title) || '' %>" required maxlength="200" autofocus>
        </div>

        <div class="form-group">
            <label for="description">Tesvir</label>
            <textarea id="description" name="description" rows="6" maxlength="5000"><%= (typeof form !== 'undefined' && form.description) || '' %></textarea>
            <small class="hint">İsteye bagli.</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Yarat</button>
            <a href="/projects" class="btn-light">Leğv et</a>
        </div>
    </form>
</div>
