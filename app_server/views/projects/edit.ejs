<div class="page-head">
    <h1>Layiheni redakte et</h1>
    <a href="/projects/<%= project.id %>" class="btn-light">← Geri</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <span class="alert-icon">!</span>
        <%= error %>
    </div>
<% } %>

<div class="form-card">
    <form action="/projects/<%= project.id %>/edit" method="POST" class="form">
        <div class="form-group">
            <label for="title">Basliq</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" required maxlength="200">
        </div>

        <div class="form-group">
            <label for="description">Tesvir</label>
            <textarea id="description" name="description" rows="6" maxlength="5000"><%= project.description || '' %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Yadda saxla</button>
            <a href="/projects/<%= project.id %>" class="btn-light">Leğv et</a>
        </div>
    </form>
</div>
