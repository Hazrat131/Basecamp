<div class="page-head">
    <h1>Yeni muzakire</h1>
    <a href="/projects/<%= project.id %>" class="btn-light">Geri</a>
</div>

<p class="muted small">Layihe: <strong><%= project.title %></strong></p>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <span class="alert-icon">!</span>
        <%= error %>
    </div>
<% } %>

<div class="form-card">
    <form action="/projects/<%= project.id %>/threads/new" method="POST" class="form">
        <div class="form-group">
            <label for="title">Basliq</label>
            <input type="text" id="title" name="title" value="<%= form.title || '' %>" required maxlength="200" autofocus>
        </div>

        <div class="form-group">
            <label for="description">Tesvir (opsional)</label>
            <textarea id="description" name="description" rows="4" maxlength="5000"><%= form.description || '' %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Yarat</button>
            <a href="/projects/<%= project.id %>" class="btn-light">Legv et</a>
        </div>
    </form>
</div>
