<div class="page-head">
    <h1>Yeni mesaj</h1>
    <a href="/projects/<%= project.id %>/threads/<%= thread.id %>" class="btn-light">← Geri</a>
</div>

<p class="muted small">Muzakire: <strong><%= thread.title %></strong></p>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <span class="alert-icon">!</span>
        <%= error %>
    </div>
<% } %>

<div class="form-card">
    <form action="/projects/<%= project.id %>/threads/<%= thread.id %>/messages/new" method="POST" class="form">
        <div class="form-group">
            <label for="body">Mesaj</label>
            <textarea id="body" name="body" rows="6" maxlength="5000" required autofocus><%= form.body || '' %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Gonder</button>
            <a href="/projects/<%= project.id %>/threads/<%= thread.id %>" class="btn-light">Leğv et</a>
        </div>
    </form>
</div>
